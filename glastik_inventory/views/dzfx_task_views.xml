<odoo>
    <!-- LIST VIEW -->
    <record id="view_dzfx_list" model="ir.ui.view">
        <field name="name">dzfx.task.list</field>
        <field name="model">dzfx.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_dzfx_form" model="ir.ui.view">
        <field name="name">dzfx.task.form</field>
        <field name="model">dzfx.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_dzfx_search" model="ir.ui.view">
        <field name="name">dzfx.task.search</field>
        <field name="model">dzfx.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>
</odoo>
