<odoo>
    <record id="view_dzfx_product_list" model="ir.ui.view">
        <field name="name">dzfx.product.list</field>
        <field name="model">dzfx.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dzfx_product_form" model="ir.ui.view">
        <field name="name">dzfx.product.form</field>
        <field name="model">dzfx.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
